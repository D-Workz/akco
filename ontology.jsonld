}, {
  "@id" : "https://d-workz.github.io/akco#dimCorrection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The error-correction dimension describes approaches and techniques that determine a replacement entity for an erroneous entity in an assertion. Typical examples for this dimension are type or link-prediction approaches."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dimCorrection"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#dimData-driven",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The data-driven dimension describes approaches and techniques that leverage statistical methods and machine learning to detect and correct errors. For example, embeddings use other assertions in the knowledge graph as context when transforming an assertion into a low-dimensional vector representation. Additionally, outlier-detection methods can identify anomalies in numerical property values, assuming a consistent domain and context."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dimData-driven"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#dimDetection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The error-detection dimension describes approaches and techniques aimed at identifying errors within a knowledge graph or a specific assertion. When the focus is on a single assertion, this process is often referred to as fact-checking"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dimDetection"
  } ],
  "https://d-workz.github.io/akco#hasDimension" : [ {
    "@id" : "https://d-workz.github.io/akco#dimDetection"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#dimExternal",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The external dimension describes approaches and techniques that rely on background knowledge from sources external to the given knowledge graph."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dimExternal"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#dimInternal",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The internal dimension describes approaches and techniques that rely solely on the given knowledge graph for background knowledge."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dimInternal"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#dimKnowledge-driven",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The knowledge-driven dimension describes approaches and techniques that rely on domain knowledge—such as ontology-based reasoning or human expertise—to detect and correct errors."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dimKnowledge-driven"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#errESemSemWrong",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
