  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Error is of semantic nature, afflicting equality assertions, and causing a semantically wrong equality assertion."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "errESemSemWrong"
  } ],
