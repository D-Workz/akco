  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#errSystematic",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#Error"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A systematic error is an error that occurs during the knowledge creation process or was part of the original source. It is characterized by the same source and occurence."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "errSystematic"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://d-workz.github.io/akco#errPVSemSemWrong"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#errTailVertical",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#Error"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A tail vertical is a domain that is not well covered by a knowledge graph. Entities in these domains are typically sparse."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "errTailVertical"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://d-workz.github.io/akco#errPVSemSemWrong"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#errorNature",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The nature of an error- An error can be semantic or syntatic. A semantic error causes the error source to express wrong semantics (meaning). A syntatic error causes the error source to express no or wrong semantics."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://d-workz.github.io/akco#Error"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "errorNature"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#errorSource",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The error source, in which an error originates. It is an assertion type, for example a wrong instance or property-value assertion."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://d-workz.github.io/akco#Error"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "errorSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#errorType",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "\"The error type is a specific error in an error source, caused by a certain type of error nature. For example, an instance assertion might have a syntatically wrong instance identifier or a syntatically wrong type name.\""
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://d-workz.github.io/akco#Error"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "errorType"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#string"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#extSrcAny",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An external source is any source outside of a given knowledge graph. This individual represents any of those sources."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcAny"
  } ],
  "http://www.w3.org/2004/02/skos/core#narrower" : [ {
    "@id" : "https://d-workz.github.io/akco#extSrcFormalAndSyntaxSpecifications"
  }, {
    "@id" : "https://d-workz.github.io/akco#extSrcKnowledgeGraph"
  }, {
    "@id" : "https://d-workz.github.io/akco#extSrcQueryLogs"
  }, {
    "@id" : "https://d-workz.github.io/akco#extSrcTextCorpus"
  }, {
    "@id" : "https://d-workz.github.io/akco#extSrcWeb"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#extSrcDBpedia",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "DBpedia is the central knowledge graph of the Linked Open Data cloud. Its source is Wikipedia."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcDBpedia"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://d-workz.github.io/akco#extSrcKnowledgeGraph"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#extSrcDomaInExpertise",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#ExpertKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Human interaction is another particular type of external source. It is versatile and uses human expertise to perform any cleaning task, including setting up and maintaining more elaborate cleaning approaches. It is mostly independent of the quality of the KG, except for\nvalidation where additional contextual knowledge might be required. Human interaction is typically included to allow for semi-automatic cleaning in combination with various cleaning techniques."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcDomaInExpertise"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#extSrcExternalSources",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "External sources are any sources outside the KG. Typical background knowledge is websites, large language models, documents, other knowledge graphs, and databases. The success of using the sources for knowledge cleaning depends on the quality of the sources and the acquisition process. The latter includes the alignment of the assertion(s) with the external source and the correct interpretation of the received results."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcExternalSources"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#extSrcFormalAndSyntaxSpecifications",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Formal - and syntax specifications are a particular type of external background knowledge.  Both are designed to explicitly define desired aspects of a knowledge graph.  The aspects can include an expected graph structure, like cardinality, syntax rules of the domain and modeling language, or semantic features of a property. Specifications are independent of the quality of the assertions. Typical formal specifications are ontologies, integrity constraints, and logic rules. Typical syntax specifications are the RDF specification , or Turtle specification ."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcFormalAndSyntaxSpecifications"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://d-workz.github.io/akco#extSrcAny"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#extSrcHornClauses",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Horn clauses, obtain from rule mining, that rewrite a fact into a set of easier-to-spot facts."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcHornClauses"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://d-workz.github.io/akco#extSrcAny"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#extSrcKnowledgeGraph",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Another Knowledge graph not yet part of the given knowledge graph, in a related domain."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcKnowledgeGraph"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://d-workz.github.io/akco#extSrcAny"
  } ],
  "http://www.w3.org/2004/02/skos/core#narrower" : [ {
    "@id" : "https://d-workz.github.io/akco#extSrcDBpedia"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#extSrcQueryLogs",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Query logs represent the context of entities, generated by a user."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcQueryLogs"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://d-workz.github.io/akco#extSrcAny"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#extSrcTextCorpus",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A text corpus that contains information about the domain of a given knowledge graph."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcTextCorpus"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://d-workz.github.io/akco#extSrcAny"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#extSrcWeb",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The World Wide Web is a rich source of information on almost any topic. It can be accessed, for example, using search engines or direct calls to websites. The resulting information can include different types of noise, ranging from contradicting information to misinformation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcWeb"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://d-workz.github.io/akco#extSrcAny"
  } ],
  "http://www.w3.org/2004/02/skos/core#narrower" : [ {
    "@id" : "https://d-workz.github.io/akco#extSrcWikipedia"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#extSrcWikipedia",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://d-workz.github.io/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Wikipedia is a free online encyclopedia that is written and maintained by a community of volunteers, known as Wikipedians, through open collaboration and the wiki software MediaWiki. It provides structured (tables, annotations) and unstructured information about many domains."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcWikipedia"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://d-workz.github.io/akco#extSrcWeb"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#hasDimension",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Approaches have different dimensions, i.e., characteristics. For example, if an approach is data- or knowledge-driven."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://d-workz.github.io/akco#Approach"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "hasDimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://d-workz.github.io/akco#Dimension"
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#hasError",
