    "@value" : "Property-value assertion"
  } ],
  "https://d-workz.github.io/akco#errorType" : [ {
    "@language" : "en",
    "@value" : "Instance (domain) uses not a proper instance identifier."
  } ]
}, {
  "@id" : "https://d-workz.github.io/akco#errPVSynNotPIdentIR",
