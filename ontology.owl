        <errorSource xml:lang="en">Equality assertion</errorSource>
        <errorType xml:lang="en">Instance (domain) uses not a proper instance identifier.</errorType>
        <rdfs:comment xml:lang="en">Error is of syntactic nature, afflicting equality assertions, and causing that the instance at the domain position uses not a proper instance identifier.</rdfs:comment>
        <rdfs:label xml:lang="en">errESynNotPIdentID</rdfs:label>
    </owl:NamedIndividual>
    


