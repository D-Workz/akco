}, {
  "@id" : "https://purl.archive.org/akco#targetedError",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A cleaning approach targets a specific type of error."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://purl.archive.org/akco#Approach"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "targeted error"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://purl.archive.org/akco#Error"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#tecCrowdsourcing-based",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Crowdsourcing-based techniques incorporate human interaction into the knowledge-cleaning process. A crowd can be engaged to detect and correct errors, leveraging either (1) domain experts or (2) anonymous contributors. Domain experts are capable of setting up and maintaining the cleaning process as well as handling complex, domain-specific issues. Anonymous crowds, on the other hand, excel at completing simpler, more generalized tasks that typically involve common knowledge and do not require specialized expertise. The technique allows to target all types of assertions, i.e., instance-, property-value -, and equality assertions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "tecCrowdsourcing-based"
  } ],
  "https://purl.archive.org/akco#usesBackgroundKnowledge" : [ {
    "@id" : "https://purl.archive.org/akco#bgkHumanExpertise"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#tecEmbeddingAndNeuralNetwork-based",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Embedding- and neural network-based techniques use supervised machine-learning, involving a training phase and an inference phase. In the training phase, a curated dataset is used to train a model for a specific cleaning task, i.e., error detection or correction of a specific type of error. During inference, the trained model is applied to unseen data to perform the trained task. Neural networks that process knowledge graphs embed the graph into a lower-dimensional vector space, also known as knowledge graph embeddings. This embedding process is based on selected features—for example, a node’s incoming and outgoing relationships as in TransE. The technique allows to target any type of assertion, i.e., instance -, property-value -, and equality assertion."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "tecEmbeddingAndNeuralNetwork-based"
  } ],
  "https://purl.archive.org/akco#usesBackgroundKnowledge" : [ {
    "@id" : "https://purl.archive.org/akco#bgkKGGraphStructure"
  }, {
    "@id" : "https://purl.archive.org/akco#extSrcExternalSources"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#tecHybrid",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Hybrid techniques combine multiple other methods to detect and correct errors in any type of assertion— instance, property-value, or equality. They merge outputs from independent processes into a single evaluation, enhancing accuracy and increasing complexity due to the need to maintain and integrate multiple techniques."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "tecHybrid"
  } ],
  "https://purl.archive.org/akco#usesBackgroundKnowledge" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcFormalAndSyntaxSpecifications"
  }, {
    "@id" : "https://purl.archive.org/akco#bgkHumanExpertise"
  }, {
    "@id" : "https://purl.archive.org/akco#bgkKGContextualGraph"
  }, {
    "@id" : "https://purl.archive.org/akco#bgkKGGraphStructure"
  }, {
    "@id" : "https://purl.archive.org/akco#bgkKGValuesOfPV"
  }, {
    "@id" : "https://purl.archive.org/akco#extSrcExternalSources"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#tecIntegrityConstraint-based",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Integrity constraint-based techniques use constraints to verify the correctness of assertions, i.e., detect errors. Integrity constraints can be provided, for example, via SHACL shapes, or generated from the ontology. They define a desired graph structure and the detection process verifies that the assertions conform to this structure. This technique allows to target instance - and property-value assertions."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "tecIntegrityConstraint-based"
  } ],
  "https://purl.archive.org/akco#usesBackgroundKnowledge" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcFormalAndSyntaxSpecifications"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#tecOntology-based",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "tecOntology-based"
  } ],
  "http://www.w3.org/2002/07/owl#backwardCompatibleWith" : [ {
    "@language" : "en",
    "@value" : "Ontology-based techniques use an ontology that describes assertions in order to detect and correct errors. Error detection typically involves reasoning over the ontology and the associated assertions. To identify inconsistencies, the ontology must include &amp;apos;negative inclusions&amp;apos; (disjoint axioms) that specify which entities or classes cannot co-occur—for example, the classes Human and Boat are usually mutually exclusive, so no individual should be assigned both types. When correcting errors in equality assertions, new or more appropriate relations may be introduced into the ontology if two instances are not semantically identical. This technique allows to target any type of assertion, i.e., instance -, property-value -, and equality assertion."
  } ],
  "http://www.w3.org/2004/02/skos/core#related" : [ {
    "@id" : "https://purl.archive.org/akco#tecIntegrityConstraint-based"
  } ],
  "https://purl.archive.org/akco#usesBackgroundKnowledge" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcFormalAndSyntaxSpecifications"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#tecPath-based",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Path-based techniques use a knowledge graph&amp;apos;s structure or semantic features to detect errors, focusing on both property-value and equality assertions.\n\nTo validate property-value assertions, these techniques identify alternative paths between the relation’s two nodes, considering measures such as path length and path count. The paths can also be constrained by semantic attributes or direction.\n\nTo validate equality assertions, path-based techniques construct contextual subgraphs around the involved instances—based, for example, on distance or on semantic properties such as transitivity. These subgraphs are then compared against each other to determine whether the two instances truly represent the same object of discourse."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "tecPath-based"
  } ],
  "http://www.w3.org/2004/02/skos/core#related" : [ {
    "@id" : "https://purl.archive.org/akco#tecEmbeddingAndNeuralNetwork-based"
  } ],
  "https://purl.archive.org/akco#usesBackgroundKnowledge" : [ {
    "@id" : "https://purl.archive.org/akco#bgkKGContextualGraph"
  }, {
    "@id" : "https://purl.archive.org/akco#bgkKGGraphStructure"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#tecRuleMining-based",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Rule mining-based techniques can detect and correct errors in both property-value and instance assertions by identifying recurring patterns in the knowledge graph’s structure. These patterns serve as the contextual ‘rules’ for detecting or correcting errors. For example, it may be typical for a Human entity to have a social security number and a date of birth; these attributes can then be used as a rule for a common graph structure around humans. In this case, counterexamples are humans that do not conform to this common structure. These examples could indicate errors or exceptions to the rule."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "tecRuleMining-based"
  } ],
  "http://www.w3.org/2004/02/skos/core#related" : [ {
    "@id" : "https://purl.archive.org/akco#tecOntology-based"
  } ],
  "https://purl.archive.org/akco#usesBackgroundKnowledge" : [ {
    "@id" : "https://purl.archive.org/akco#bgkKGGraphStructure"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#tecStatistical",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Statistical techniques address both instance and property-value assertions by leveraging a statistical context derived from the knowledge graph. This context may include other property-value assertions or the incoming and outgoing relations of a node. By comparing observed data to expected statistical patterns, outliers—unexpected deviations from the context—can be identified and flagged as potential errors."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "tecStatistical"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#tecSyntactic",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Syntactic techniques take advantage of syntax specifications to parse knowledge graph serializations. Serializations are &amp;quot;downloaded&amp;quot; versions of a knowledge graph, i.e., a Resource Description Framework graph. Typical formats are Turtle or OWL/RDF. The syntax specifications define expected symbols and their arrangement. A parser loads a specification and then parses an input, for example, a Turtle file. It reports violations, i.e., detects syntactic errors; sometimes, a correction is attempted by updating a specific syntax part."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "tecSyntactic"
  } ],
  "https://purl.archive.org/akco#usesBackgroundKnowledge" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcFormalAndSyntaxSpecifications"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#tecVerbalization-based",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Verbalization-based techniques are based on external natural language sources, such as the Web or documents. They validate property-value assertions by translating them, i.e., verbalizing, into a natural language claim. This process can, for example, use templates or machine learning. The claim is then used to search a given external source. The result is natural language evidence, which is then analyzed, using typically crowdsourcing or machine learning. This technique includes using any large-language model, like ChatGPT."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "tecVerbalization-based"
  } ],
  "https://purl.archive.org/akco#usesBackgroundKnowledge" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcAny"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#usesBackgroundKnowledge",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A cleaning technique leverages a specific type of background knowledge as context."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "uses background Knowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://purl.archive.org/akco#BackgroundKnowledge"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#usesTechnique",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An approaches implements specific cleaning techniques. This property defines those used/implemented techniques."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://purl.archive.org/akco#Approach"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "uses technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ]
} ]