}, {
  "@id" : "http://www.w3.org/ns/dqv",
  "http://purl.org/dc/terms/modified" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2016-08-26"
  }, {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "2016-12-15"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Data Quality Vocabulary"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/dqv#QualityMeasurement",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Represents the evaluation of a given dataset (or dataset distribution) against a specific quality metric."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Quality Measurement"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/dqv#hasQualityMeasurement",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Refers to the performed quality measurements. Quality measurements can be performed to any kind of resource (e.g., a dataset, a linkset, a graph, a set of triples). However, in the DQV context, this property is generally expected to be used in statements in which subjects are instances of dcat:Dataset or dcat:Distribution."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://purl.archive.org/akco#BackgroundKnowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has quality measurement"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/ns/dqv#QualityMeasurement"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/dqv#hasQualityMetadata",
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Refers to a grouping of quality information such as certificates, policies, measurements and annotations as a named graph. Quality information represented in such a grouping can pertain to any kind of resource (e.g., a dataset, a linkset, a graph, a set of triples). However, in the DQV context, this property is generally expected to be used in statements in which subjects are instances of dcat:Dataset or dcat:Distribution."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has quality metadata"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/dqv#inCategory",
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Represents the category a dimension is grouped in."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "in category"
  } ]
}, {
  "@id" : "http://www.w3.org/ns/dqv#inDimension",
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Represents the dimensions a quality metric, certificate and annotation allow a measurement of."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "in dimension"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#",
  "@type" : [ "http://www.w3.org/2002/07/owl#Ontology" ],
  "http://purl.org/dc/terms/bibliographicCitation" : [ {
    "@language" : "en",
    "@value" : "D. Sommer. U. Serles, Anatomy of Knowledge Cleaning Ontology (AKCO), 2025, https://purl.archive.org/akco"
  } ],
  "http://purl.org/dc/terms/contributor" : [ {
    "@value" : "https://orcid.org/0009-0009-8524-9182"
  } ],
  "http://purl.org/dc/terms/created" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "13.08.2025"
  } ],
  "http://purl.org/dc/terms/creator" : [ {
    "@value" : "https://orcid.org/0009-0009-8524-9182"
  } ],
  "http://purl.org/dc/terms/description" : [ {
    "@language" : "en",
    "@value" : "The Anatomy of Knowledge Cleaning Ontology (AKCO) represents relevant aspects of knowledge cleaning assertion errors in knowledge graphs. The correctness of a knowledge graph is essential for its successful application. Knowledge cleaning, i.e., error detection and correction, aims to improve this correctness. A knowledge graph, typically, represents most knowledge as assertions, and commonly, three types of assertions are used: instance, property-value, and equality assertions. Each assertion type has unique features, requiring specific approaches to target their syntax or semantics and evaluate them.\n\nGaining an overview of the possibilities is essential before implementing knowledge cleaning, since approaches have dependencies that need to be understood. For example, integrity constraints could be applied to detect if a knowledge graph conforms to certain specifications. However, to obtain integrity constraints, it is essential to have domain knowledge. This knowledge could be provided by an ontology that covers the assertions or by domain experts. If those sources are not available or are of insufficient quality, another cleaning technique might be better suited for a given knowledge graph.\n\nThe AKCO allows the representation of all relevant aspects of a cleaning process, providing insights into dependencies and relevant related aspects. This organization enables knowledge graph maintainers to focus solely on the aspects that are best suited for cleaning a knowledge graph, considering its features, user requirements, and additional knowledge sources.\n\nThe AKCO already contains over 100 instances (named individuals) that represent various facts of knowledge cleaning, including different types of background knowledge, cleaning techniques, dimensions, and a vast number of cleaning approaches. These instances provide a foundational understanding of the different aspects of knowledge cleaning and offer a selection of approaches."
  } ],
  "http://purl.org/dc/terms/language" : [ {
    "@language" : "en",
    "@value" : "English"
  } ],
  "http://purl.org/dc/terms/license" : [ {
    "@type" : "http://purl.org/dc/terms/URI",
    "@value" : "https://creativecommons.org/licenses/by/4.0/"
  } ],
  "http://purl.org/dc/terms/title" : [ {
    "@language" : "en",
    "@value" : "Anatomy of Knowledge Cleaning Ontology (AKCO)"
  } ],
  "http://purl.org/vocab/vann/preferredNamespacePrefix" : [ {
    "@language" : "en",
    "@value" : "akco"
  } ],
  "http://purl.org/vocab/vann/preferredNamespaceUri" : [ {
    "@type" : "http://purl.org/dc/terms/URI",
    "@value" : "https://purl.archive.org/akco"
  } ],
  "http://www.w3.org/2002/07/owl#priorVersion" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "https://d-workz.github.io/akco/versions/1.0.0/"
  } ],
  "http://www.w3.org/2002/07/owl#versionIRI" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "https://d-workz.github.io/akco/versions/1.0.0/"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@type" : "http://www.w3.org/2001/XMLSchema#date",
    "@value" : "1.0.0"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#Approach",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An approach is a cleaning solution that targets a specific error type and source, performing error detection and/or correction. Each approach employs a particular technique and leverages background knowledge."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Approach"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ],
  "http://www.w3.org/2002/07/owl#disjointWith" : [ {
    "@id" : "https://purl.archive.org/akco#Technique"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#BackgroundKnowledge",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Background knowledge provides the necessary context for a cleaning technique to detect or correct errors."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Background knowledge"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#Dimension",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A dimension is a specific characteristic of a cleaning approach or technique. All approaches or techniques that share a dimension have a specific feature in common. For example, internal approaches only use a given knowledge graph as background knowledge, while external approaches consult other (knowledge) sources."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#Error",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An error is an incorrect assertion. The error source, error nature, and error type further define it. The source identifies the type of assertion that is incorrect. The nature identifies if the error is semantic or syntactic. The combination of the error nature inside the error source defines the error type."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Error"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#ExternalSource",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "An external source contains domain-relevant information that is not part of the given knowledge graph."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "External source"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/linked-data/cube#DataSet"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#HumanExpertise",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Expert knowledge is provided by human expertise; It includes (domain) expertise, expertise about the cleaning process in general, and involved (semantic) technologies. Different types of expertise may be required to apply specific approaches and techniques successfully."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Human expertise"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "https://purl.archive.org/akco#BackgroundKnowledge"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#KnowledgeGraph",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A knowledge graph is a data structure that can represent any domain or subject area. It structures domain knowledge in a machine-processable manner. It is a semantic network, also known as a knowledge base."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Knowledge graph"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://purl.org/linked-data/cube#DataSet"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#Technique",
  "@type" : [ "http://www.w3.org/2002/07/owl#Class" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A cleaning technique describes a specific methodology used for detecting or correcting errors. It uses different types of background knowledge as a context. The techniques differ in their background knowledge and how each technique utilizes it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Technique"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subClassOf" : [ {
    "@id" : "http://www.w3.org/2004/02/skos/core#Concept"
  } ]
