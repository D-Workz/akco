        <rdfs:label xml:lang="en">appAPE</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.archive.org/akco#appAPrInToImLiDaQuUsDiOuDe -->


    <owl:NamedIndividual rdf:about="https://purl.archive.org/akco#appAPrInToImLiDaQuUsDiOuDe">
        <rdf:type rdf:resource="https://purl.archive.org/akco#Approach"/>
        <hasDimension rdf:resource="https://purl.archive.org/akco#dimData-driven"/>
        <hasDimension rdf:resource="https://purl.archive.org/akco#dimDetection"/>
        <hasDimension rdf:resource="https://purl.archive.org/akco#dimInternal"/>
        <isPublished rdf:resource="https://purl.archive.org/akco#publAPrInToImLiDaQuUsDiOuDe"/>
