  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkExtSrcDBpedia",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "DBpedia is the central knowledge graph of the Linked Open Data cloud. Its source is Wikipedia."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "DBpedia"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcKnowledgeGraph"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkExtSrcFormalAndSyntaxSpecifications",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Formal - and syntax specifications are a particular type of external background knowledge.  Both are designed to explicitly define desired aspects of a knowledge graph.  The aspects can include an expected graph structure, like cardinality, syntax rules of the domain and modeling language, or semantic features of a property. Specifications are independent of the quality of the assertions. Typical formal specifications are ontologies, integrity constraints, and logic rules. Typical syntax specifications are the RDF specification , or Turtle specification ."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Formal and syntax specifications"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcAny"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkExtSrcHornClauses",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Horn clauses, obtain from rule mining, that rewrite a fact into a set of easier-to-spot facts."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Horn clauses"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcAny"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkExtSrcKnowledgeGraph",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Another Knowledge graph not yet part of the given knowledge graph, in a related domain."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Knowledge graph"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcAny"
  } ],
  "http://www.w3.org/2004/02/skos/core#narrower" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcDBpedia"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkExtSrcQueryLogs",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Query logs represent the context of entities, generated by a user."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Query logs"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcAny"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkExtSrcTextCorpus",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A text corpus that contains information about the domain of a given knowledge graph."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Text corpus"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcAny"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkExtSrcWeb",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The World Wide Web is a rich source of information on almost any topic. It can be accessed, for example, using search engines or direct calls to websites. The resulting information can include different types of noise, ranging from contradicting information to misinformation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "The Web"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcAny"
  } ],
  "http://www.w3.org/2004/02/skos/core#narrower" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcWikipedia"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkExtSrcWikipedia",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#ExternalSource"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Wikipedia is a free online encyclopedia that is written and maintained by a community of volunteers, known as Wikipedians, through open collaboration and the wiki software MediaWiki. It provides structured (tables, annotations) and unstructured information about many domains."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Wikipedia"
  } ],
  "http://www.w3.org/2004/02/skos/core#broader" : [ {
    "@id" : "https://purl.archive.org/akco#bgkExtSrcWeb"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkHumanExpertise",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#HumanExpertise"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Human interaction is another particular type of external source. It is versatile and uses human expertise to perform any cleaning task, including setting up and maintaining more elaborate cleaning approaches. It is mostly independent of the quality of the KG, except for\nvalidation where additional contextual knowledge might be required. Human interaction is typically included to allow for semi-automatic cleaning in combination with various cleaning techniques."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "extSrcDomaInExpertise"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkKGContextualGraph",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#KnowledgeGraph"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Contextual graphs are subgraphs of relevant assertions. Assertions are relevant if they are part of the context, which is used within error detection or correction. For example, the context could identify an instance to validate equality assertions, or it is identified as part of reasoning, and contains contradicting knowledge.\nA contextual graph can also be be beneficial to provide a context for clarifying the domain of an assertion during error detection. They are generated in various ways, for example, by selecting all assertions conforming to specific semantics, such as transitive properties, or constructing it as an undirected identity network (Raad, Beek, Harmelen, et al., 2018)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Contextual graph"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkKGGraphStructure",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#KnowledgeGraph"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Knowledge graphs represent knowledge as a collection of entities (nodes) and relations (edges) between the entities. The graph structure is used by various cleaning techniques as background knowledge. It is an internal type of background knowledge. It is independent of assertion type and formal semantics of assertions. However, it depends on the overall quality (correctness &amp;amp; completeness) of the overall KG since it is typically used with data-driven measures."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Graph structure"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#bgkKGValuesOfPV",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#KnowledgeGraph"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The values of property-value assertions include numerical literal values and URI instances. They are an internal type of background knowledge and depend on the relevant subset of the KG for a target property-value assertion. The values are targeted using statistical approaches."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Values of property-value assertions"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#dimCorrection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The error-correction dimension describes approaches and techniques that determine a replacement entity for an erroneous entity in an assertion. Typical examples for this dimension are type or link-prediction approaches."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dimCorrection"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#dimData-driven",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The data-driven dimension describes approaches and techniques that leverage statistical methods and machine learning to detect and correct errors. For example, embeddings use other assertions in the knowledge graph as context when transforming an assertion into a low-dimensional vector representation. Additionally, outlier-detection methods can identify anomalies in numerical property values, assuming a consistent domain and context."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dimData-driven"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#dimDetection",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The error-detection dimension describes approaches and techniques aimed at identifying errors within a knowledge graph or a specific assertion. When the focus is on a single assertion, this process is often referred to as fact-checking"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dimDetection"
  } ],
  "https://purl.archive.org/akco#hasDimension" : [ {
    "@id" : "https://purl.archive.org/akco#dimDetection"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#dimExternal",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The external dimension describes approaches and techniques that rely on background knowledge from sources external to the given knowledge graph."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dimExternal"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#dimInternal",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The internal dimension describes approaches and techniques that rely solely on the given knowledge graph for background knowledge."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "dimInternal"
  } ]
}, {
  "@id" : "https://purl.archive.org/akco#dimKnowledge-driven",
  "@type" : [ "http://www.w3.org/2002/07/owl#NamedIndividual" ],
  "http://www.w3.org/1999/02/22-rdf-syntax-ns#type" : [ {
    "@id" : "https://purl.archive.org/akco#Dimension"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
