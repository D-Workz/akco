  } ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Error is of semantic or syntactic nature, afflicting property-value assertions, and causing that the assertion uses a not existing property name.."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "errPVSemSynNotEProperty"
  } ],
